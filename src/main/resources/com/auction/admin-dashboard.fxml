<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefWidth="1200" prefHeight="700" style="-fx-background-color: #f0f4f8;"
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.AdminDashboardController">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #1976D2; -fx-padding: 15 30;">
            <Label text="AUCTION.IO" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="| ADMIN PANEL" style="-fx-font-size: 16; -fx-text-fill: #bbdefb;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblAdminName" text="👤 Admin"
                   style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: white;"/>
            <Button text="Đăng xuất" onAction="#handleLogout"
                    style="-fx-background-color: white; -fx-text-fill: #1976D2;
                           -fx-font-weight: bold; -fx-border-radius: 5;
                           -fx-background-radius: 5; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- SIDEBAR TRÁI -->
    <left>
        <VBox spacing="5" prefWidth="220"
              style="-fx-background-color: #1565C0; -fx-padding: 20 10;">

            <Label text="MENU" style="-fx-text-fill: #90caf9; -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 10 10 5 10;"/>

            <Button fx:id="btnOverview" text="📊  Tổng quan" onAction="#showOverview"
                    prefWidth="200" alignment="CENTER_LEFT"
                    style="-fx-background-color: white; -fx-text-fill: #1976D2;
                           -fx-font-weight: bold; -fx-padding: 12 15;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="btnUsers" text="👥  Quản lý Users" onAction="#showUsers"
                    prefWidth="200" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-padding: 12 15;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="btnProducts" text="📦  Duyệt sản phẩm" onAction="#showProducts"
                    prefWidth="200" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-padding: 12 15;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="btnDeposits" text="💰  Duyệt nạp tiền" onAction="#showDeposits"
                    prefWidth="200" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-padding: 12 15;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>

            <Button fx:id="btnAuctions" text="🏷️  Quản lý đấu giá" onAction="#showAuctions"
                    prefWidth="200" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white;
                           -fx-font-size: 13; -fx-padding: 12 15;
                           -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- NỘI DUNG CHÍNH -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 25;">

            <!-- TAB 1: TỔNG QUAN -->
            <VBox fx:id="paneOverview" spacing="20" visible="true">
                <Label text="Tổng quan hệ thống"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>

                <!-- 4 thẻ số liệu -->
                <HBox spacing="20">
                    <!-- Thẻ Users -->
                    <VBox alignment="CENTER" spacing="8" prefWidth="200" prefHeight="110"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                        <Label text="👥" style="-fx-font-size: 28;"/>
                        <Label fx:id="lblTotalUsers" text="0"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                        <Label text="Tổng Users" style="-fx-text-fill: #7f8c8d;"/>
                    </VBox>

                    <!-- Thẻ Sản phẩm -->
                    <VBox alignment="CENTER" spacing="8" prefWidth="200" prefHeight="110"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                        <Label text="📦" style="-fx-font-size: 28;"/>
                        <Label fx:id="lblTotalProducts" text="0"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                        <Label text="Sản phẩm đang đấu" style="-fx-text-fill: #7f8c8d;"/>
                    </VBox>

                    <!-- Thẻ chờ duyệt -->
                    <VBox alignment="CENTER" spacing="8" prefWidth="200" prefHeight="110"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                        <Label text="⏳" style="-fx-font-size: 28;"/>
                        <Label fx:id="lblPending" text="0"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
                        <Label text="Chờ duyệt" style="-fx-text-fill: #7f8c8d;"/>
                    </VBox>

                    <!-- Thẻ doanh thu -->
                    <VBox alignment="CENTER" spacing="8" prefWidth="200" prefHeight="110"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                        <Label text="💵" style="-fx-font-size: 28;"/>
                        <Label fx:id="lblRevenue" text="0 VNĐ"
                               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                        <Label text="Doanh thu" style="-fx-text-fill: #7f8c8d;"/>
                    </VBox>
                </HBox>

                <!-- Hoạt động gần đây -->
                <VBox spacing="10"
                      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 10, 0, 0, 4);">
                    <Label text="🕒 Hoạt động gần đây"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Separator/>
                    <Label text="• MINH đã đăng ký tài khoản" style="-fx-text-fill: #555;"/>
                    <Label text="• iPhone 15 Pro Max đang được đấu giá - Giá: 35,000,000 VNĐ" style="-fx-text-fill: #555;"/>
                    <Label text="• Yêu cầu nạp tiền 500,000 VNĐ đang chờ duyệt" style="-fx-text-fill: #e67e22;"/>
                </VBox>
            </VBox>

            <!-- TAB 2: QUẢN LÝ USERS -->
            <VBox fx:id="paneUsers" spacing="15" visible="false">
                <Label text="👥 Quản lý người dùng"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                <TableView fx:id="tableUsers" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colUserId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colUserName" text="Tên tài khoản" prefWidth="150"/>
                        <TableColumn fx:id="colUserEmail" text="Email" prefWidth="200"/>
                        <TableColumn fx:id="colUserRole" text="Role" prefWidth="100"/>
                        <TableColumn fx:id="colUserBalance" text="Số dư" prefWidth="120"/>
                        <TableColumn fx:id="colUserStatus" text="Trạng thái" prefWidth="120"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="🔒 Khóa tài khoản" onAction="#handleLockUser"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 8 15;
                                   -fx-background-radius: 5; -fx-cursor: hand;"/>
                    <Button text="🔓 Mở khóa" onAction="#handleUnlockUser"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 8 15;
                                   -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- TAB 3: DUYỆT SẢN PHẨM -->
            <VBox fx:id="paneProducts" spacing="15" visible="false">
                <Label text="📦 Duyệt sản phẩm"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                <TableView fx:id="tableProducts" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProductName" text="Tên sản phẩm" prefWidth="200"/>
                        <TableColumn fx:id="colProductCategory" text="Danh mục" prefWidth="120"/>
                        <TableColumn fx:id="colProductPrice" text="Giá khởi điểm" prefWidth="150"/>
                        <TableColumn fx:id="colProductSeller" text="Người đăng" prefWidth="150"/>
                        <TableColumn fx:id="colProductStatus" text="Trạng thái" prefWidth="120"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="✅ Duyệt" onAction="#handleApproveProduct"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 8 15;
                                   -fx-background-radius: 5; -fx-cursor: hand;"/>
                    <Button text="❌ Từ chối" onAction="#handleRejectProduct"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 8 15;
                                   -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- TAB 4: DUYỆT NẠP TIỀN -->
            <VBox fx:id="paneDeposits" spacing="15" visible="false">
                <Label text="💰 Duyệt yêu cầu nạp tiền"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                <TableView fx:id="tableDeposits" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDepositUser" text="Tài khoản" prefWidth="150"/>
                        <TableColumn fx:id="colDepositAmount" text="Số tiền" prefWidth="150"/>
                        <TableColumn fx:id="colDepositTime" text="Thời gian" prefWidth="180"/>
                        <TableColumn fx:id="colDepositStatus" text="Trạng thái" prefWidth="120"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="✅ Duyệt nạp tiền" onAction="#handleApproveDeposit"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 8 15;
                                   -fx-background-radius: 5; -fx-cursor: hand;"/>
                    <Button text="❌ Từ chối" onAction="#handleRejectDeposit"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 8 15;
                                   -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <!-- TAB 5: QUẢN LÝ ĐẤU GIÁ -->
            <VBox fx:id="paneAuctions" spacing="15" visible="false">
                <Label text="🏷️ Quản lý phiên đấu giá"
                       style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                <TableView fx:id="tableAuctions" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAuctionProduct" text="Sản phẩm" prefWidth="200"/>
                        <TableColumn fx:id="colAuctionPrice" text="Giá hiện tại" prefWidth="150"/>
                        <TableColumn fx:id="colAuctionLeader" text="Người dẫn đầu" prefWidth="150"/>
                        <TableColumn fx:id="colAuctionTime" text="Thời gian còn lại" prefWidth="150"/>
                        <TableColumn fx:id="colAuctionStatus" text="Trạng thái" prefWidth="120"/>
                    </columns>
                </TableView>
                <HBox spacing="10">
                    <Button text="⏹️ Dừng phiên" onAction="#handleStopAuction"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 8 15;
                                   -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

        </StackPane>
    </center>
</BorderPane>