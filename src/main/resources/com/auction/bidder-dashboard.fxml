<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Circle?>

<BorderPane stylesheets="@css/styles.css" prefWidth="1200" prefHeight="700"
            style="-fx-background-color: #f0f4ff;"
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.BidderDashboardController">

    <!-- ═══════════════ HEADER ═══════════════ -->
    <top>
        <HBox alignment="CENTER" spacing="16"
              style="-fx-background-color: white;
                     -fx-padding: 10 24 10 16;
                     -fx-border-color: #e8edf5;
                     -fx-border-width: 0 0 1 0;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 8, 0, 0, 2);">

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="8" minWidth="160">
                <StackPane minWidth="34" minHeight="34" maxWidth="34" maxHeight="34"
                           style="-fx-background-color: #4d97ff; -fx-background-radius: 8;">
                    <Label text="🔨" style="-fx-font-size: 16;"/>
                </StackPane>
                <Label text="AUCTION.IO"
                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
            </HBox>

            <!-- Search -->
            <HBox alignment="CENTER" HBox.hgrow="ALWAYS">
                <StackPane prefWidth="500" maxWidth="540">
                    <VBox>
                        <TextField fx:id="txtSearch"
                                   promptText="🔍  Tìm kiếm sản phẩm..."
                                   style="-fx-background-radius: 22;
                                          -fx-padding: 10 20;
                                          -fx-border-color: #dde3f0;
                                          -fx-border-radius: 22;
                                          -fx-background-color: #f5f7fc;
                                          -fx-font-size: 13;"/>
                        <!-- Dropdown tìm kiếm -->
                        <VBox fx:id="searchDropdown" visible="false" managed="false"
                              style="-fx-background-color: white;
                                     -fx-background-radius: 12;
                                     -fx-border-color: #dde3f0;
                                     -fx-border-radius: 12;
                                     -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.12), 14, 0, 0, 6);">
                            <HBox alignment="CENTER_LEFT" spacing="6"
                                  style="-fx-padding: 10 14 8 14;
                                         -fx-border-color: transparent transparent #f0f4ff transparent;
                                         -fx-border-width: 0 0 1 0;">
                                <Label text="🔍" style="-fx-font-size: 11;"/>
                                <Label text="KẾT QUẢ TÌM KIẾM"
                                       style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #94aac8;"/>
                            </HBox>
                            <ListView fx:id="searchList" prefHeight="180"
                                      style="-fx-background-color: transparent;
                                             -fx-border-color: transparent;
                                             -fx-padding: 4 6 6 6;
                                             -fx-font-size: 13;"/>
                        </VBox>
                    </VBox>
                </StackPane>
            </HBox>

            <!-- User info -->
            <HBox alignment="CENTER_RIGHT" spacing="12" minWidth="200">
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="lblUsername" text="Bidder"
                           style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1e3154;"/>
                    <Label fx:id="lblBalance" text="Số dư: 0 VNĐ"
                           style="-fx-font-size: 12; -fx-text-fill: #3b82f6; -fx-font-weight: bold;"/>
                </VBox>
                <StackPane minWidth="36" minHeight="36" maxWidth="36" maxHeight="36"
                           style="-fx-background-color: #3b82f6; -fx-background-radius: 18;">
                    <Label fx:id="lblAvatar" text="B"
                           style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </StackPane>
                <Button text="⇒  Đăng xuất" onAction="#handleLogout"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #e74c3c;
                               -fx-border-radius: 20;
                               -fx-text-fill: #e74c3c;
                               -fx-cursor: hand;
                               -fx-padding: 8 16;
                               -fx-font-weight: bold;
                               -fx-font-size: 12;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ═══════════════ SIDEBAR TRÁI ═══════════════ -->
    <left>
        <VBox spacing="10" prefWidth="220"
              style="-fx-background-color: transparent; -fx-padding: 16 12 16 12;">

            <!-- Danh mục (dynamic từ DB) -->
            <VBox spacing="6"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-color: #e8edf5;
                         -fx-border-radius: 12;
                         -fx-padding: 14 12 14 12;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 6, 0, 0, 2);">

                <Label text="DANH MỤC"
                       style="-fx-font-weight: bold; -fx-font-size: 11; -fx-text-fill: #94aac8; -fx-padding: 0 0 6 4;"/>

                <!-- Accordion tĩnh giữ UI đẹp -->
                <Accordion>
                    <panes>
                        <TitledPane animated="true"
                                    style="-fx-background-color: #eff6ff; -fx-background-radius: 8;">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <StackPane minWidth="24" minHeight="24" maxWidth="24" maxHeight="24"
                                               style="-fx-background-color: #dbeafe; -fx-background-radius: 5;">
                                        <Label text="💻" style="-fx-font-size: 12;"/>
                                    </StackPane>
                                    <Label text="Đồ Điện Tử"
                                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
                                    <Label fx:id="lblCountElectronics" text="0"
                                           style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                                                  -fx-font-size: 10; -fx-font-weight: bold;
                                                  -fx-background-radius: 10; -fx-padding: 2 6;"/>
                                </HBox>
                            </graphic>
                            <content>
                                <VBox fx:id="listElectronics" spacing="2"
                                      style="-fx-padding: 6 8 8 8; -fx-background-color: #f8fbff;"/>
                            </content>
                        </TitledPane>

                        <TitledPane animated="true"
                                    style="-fx-background-color: #faf5ff; -fx-background-radius: 8;">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <StackPane minWidth="24" minHeight="24" maxWidth="24" maxHeight="24"
                                               style="-fx-background-color: #ede9fe; -fx-background-radius: 5;">
                                        <Label text="🎨" style="-fx-font-size: 12;"/>
                                    </StackPane>
                                    <Label text="Nghệ Thuật"
                                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #8e44ad;"/>
                                    <Label fx:id="lblCountArt" text="0"
                                           style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                                                  -fx-font-size: 10; -fx-font-weight: bold;
                                                  -fx-background-radius: 10; -fx-padding: 2 6;"/>
                                </HBox>
                            </graphic>
                            <content>
                                <VBox fx:id="listArt" spacing="2"
                                      style="-fx-padding: 6 8 8 8; -fx-background-color: #fdf8ff;"/>
                            </content>
                        </TitledPane>

                        <TitledPane animated="true"
                                    style="-fx-background-color: #f0fdf4; -fx-background-radius: 8;">
                            <graphic>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <StackPane minWidth="24" minHeight="24" maxWidth="24" maxHeight="24"
                                               style="-fx-background-color: #dcfce7; -fx-background-radius: 5;">
                                        <Label text="🚗" style="-fx-font-size: 12;"/>
                                    </StackPane>
                                    <Label text="Phương Tiện"
                                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                                    <Label fx:id="lblCountVehicle" text="0"
                                           style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                                  -fx-font-size: 10; -fx-font-weight: bold;
                                                  -fx-background-radius: 10; -fx-padding: 2 6;"/>
                                </HBox>
                            </graphic>
                            <content>
                                <VBox fx:id="listVehicle" spacing="2"
                                      style="-fx-padding: 6 8 8 8; -fx-background-color: #f6fef9;"/>
                            </content>
                        </TitledPane>
                    </panes>
                </Accordion>
            </VBox>

            <!-- Nút đăng sản phẩm -->
            <Button text="＋  Đăng sản phẩm" onAction="#handleAddProduct"
                    prefWidth="196"
                    style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                           -fx-font-weight: bold; -fx-padding: 11; -fx-background-radius: 10;
                           -fx-cursor: hand; -fx-font-size: 13;
                           -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.35), 10, 0, 0, 3);"/>

            <!-- Thống kê (dynamic) -->
            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-color: #e8edf5;
                         -fx-border-radius: 12;
                         -fx-padding: 14 12;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                <Label text="THỐNG KÊ"
                       style="-fx-font-weight: bold; -fx-font-size: 11; -fx-text-fill: #94aac8;"/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Phiên đang chạy"
                           style="-fx-font-size: 12; -fx-text-fill: #4a6080;" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblRunningCount" text="0"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Sắp kết thúc"
                           style="-fx-font-size: 12; -fx-text-fill: #4a6080;" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblEndingSoonCount" text="0"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Lượt đặt giá hôm nay"
                           style="-fx-font-size: 12; -fx-text-fill: #4a6080;" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblBidCount" text="0"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════ SIDEBAR PHẢI ═══════════════ -->
    <right>
        <VBox spacing="12" prefWidth="260" style="-fx-padding: 16 12 16 8;">

            <!-- Nạp tiền card -->
            <VBox spacing="10"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-color: #e8edf5;
                         -fx-border-radius: 12;
                         -fx-padding: 16 14;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="💰" style="-fx-font-size: 15;"/>
                    <Label text="NẠP TIỀN"
                           style="-fx-font-weight: bold; -fx-font-size: 14; -fx-text-fill: #1e3154;"/>
                </HBox>
                <Label text="Nạp tiền để tham gia đấu giá ngay"
                       style="-fx-text-fill: #94aac8; -fx-font-size: 12;" wrapText="true"/>
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 2 0 0 0;">
                    <Label text="Số dư hiện tại"
                           style="-fx-font-size: 12; -fx-text-fill: #4a6080;" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblRightBalance" text="0 VNĐ"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                </HBox>
                <Button text="🏦  Nạp qua VNPay" onAction="#handleDeposit" prefWidth="232"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 8;
                               -fx-cursor: hand; -fx-font-size: 13;
                               -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.3), 8, 0, 0, 2);"/>
            </VBox>

            <!-- Lịch sử theo dõi (dynamic) -->
            <VBox spacing="10" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-color: #e8edf5;
                         -fx-border-radius: 12;
                         -fx-padding: 16 14;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 6, 0, 0, 2);">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="🕒" style="-fx-font-size: 14;"/>
                    <Label text="LỊCH SỬ THEO DÕI"
                           style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1e3154;"/>
                </HBox>
                <Separator/>
                <!-- Dynamic history items sẽ được inject vào đây -->
                <VBox fx:id="historyBox" spacing="8"/>
            </VBox>

            <!-- Mẹo đấu giá -->
            <VBox spacing="6"
                  style="-fx-background-color: #eff6ff;
                         -fx-background-radius: 12;
                         -fx-border-color: #dbeafe;
                         -fx-border-radius: 12;
                         -fx-padding: 14 12;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="💡" style="-fx-font-size: 13;"/>
                    <Label text="Mẹo đấu giá"
                           style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1976D2;"/>
                </HBox>
                <Label text="Theo dõi phiên trước khi đặt giá để nắm xu hướng tốt hơn!"
                       style="-fx-font-size: 11; -fx-text-fill: #4a6080;"
                       wrapText="true"/>
            </VBox>
        </VBox>
    </right>

    <!-- ═══════════════ CENTER ═══════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;
                           -fx-background: #f0f4ff;
                           -fx-border-color: transparent;">
            <padding><Insets top="16" right="12" bottom="16" left="12"/></padding>

            <VBox spacing="16">

                <!-- Banner chào (dynamic username) -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-background-color: linear-gradient(to right, #2563eb, #3b82f6);
                             -fx-background-radius: 14;
                             -fx-padding: 20 24;
                             -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.3), 12, 0, 0, 4);">
                    <VBox spacing="6">
                        <Label text="PHIÊN ĐẶC BIỆT HÔM NAY"
                               style="-fx-font-size: 11; -fx-font-weight: bold;
                                      -fx-text-fill: rgba(255,255,255,0.75);"/>
                        <Label fx:id="lblWelcome" text="Chào mừng trở lại! 👋"
                               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label fx:id="lblBannerSub" text="Đang tải các phiên đấu giá..."
                               style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.85);"/>
                    </VBox>
                </HBox>

                <!-- Header sản phẩm -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="Sản phẩm đấu giá"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
                </HBox>

                <!-- Product cards flow (dynamic) -->
                <FlowPane fx:id="productFlow" hgap="16" vgap="16"/>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
