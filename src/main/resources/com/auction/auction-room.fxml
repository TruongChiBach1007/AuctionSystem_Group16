<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<!-- Khung nền xám nhạt -->
<BorderPane prefWidth="1100" prefHeight="700" style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.AuctionRoomController">

    <!-- HEADER: Nút Quay Lại & Tiêu đề và đồng hodo đếm ngược-->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: #1a1a1a; -fx-padding: 10 25;">

            <Button onAction="#handleBackToDashboard" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="⬅ Quay lại" />

            <Region HBox.hgrow="ALWAYS" /> <Label text="OnlineAuction.bet" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'System'; -fx-opacity: 0.8;"/>
            <Region HBox.hgrow="ALWAYS" /> <VBox alignment="CENTER" spacing="2" style="-fx-background-color: #2c3e50; -fx-padding: 5 15; -fx-background-radius: 8; -fx-border-color: #bdc3c7; -fx-border-radius: 8;">
            <Label text="THỜI GIAN CÒN LẠI" style="-fx-font-size: 9; -fx-text-fill: #bdc3c7; -fx-font-weight: bold;" />
            <HBox alignment="CENTER" spacing="5">
                <Label fx:id="minutesLabel" text="05" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Arial Black';" />
                <Label text=":" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Label fx:id="secondsLabel" text="00" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white; -fx-font-family: 'Arial Black';" />
            </HBox>
        </VBox>

            <Label text="🔥 Live" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold; -fx-background-color: white; -fx-padding: 3 10; -fx-background-radius: 15; -fx-font-size: 11; margin-left: 15;">
                <HBox.margin>
                    <Insets left="15.0" />
                </HBox.margin>
            </Label>
        </HBox>
    </top>
    <!-- NỘI DUNG CHÍNH (Chia 2 cột) -->
    <center>
        <HBox spacing="20" style="-fx-padding: 20;">

            <!-- CỘT TRÁI: BẢNG SẢN PHẨM & Ô ĐẶT GIÁ -->
            <VBox spacing="15" prefWidth="450" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                <Label text="📋 Lịch sử đặt giá" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2c3e50;"/>

                <!-- BẢNG DANH SÁCH -->
                <TableView fx:id="auctionTable" VBox.vgrow="ALWAYS" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5;">
                    <columns>
                        <TableColumn fx:id="nguoiDatCol" text="Người đặt" prefWidth="120"/>
                        <TableColumn fx:id="giaCol" text="Mức giá (VND)" prefWidth="120"/>
                        <TableColumn fx:id="thoiGianCol" text="Thời gian" prefWidth="100"/>
                    </columns>
                </TableView>

                <!-- KHU VỰC NHẬP GIÁ -->
                <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8;">
                    <TextField fx:id="bidInput" onAction="#handlePlaceBid" promptText="Nhập giá (VND)..." prefWidth="200" style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #3498db; -fx-border-radius: 5; -fx-font-size: 14;"/>

                    <Button text="🚀 ĐẶT GIÁ" onAction="#handlePlaceBid" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 10 20; -fx-background-radius: 5; -fx-cursor: hand;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <Label fx:id="statusLabel" text="Chào mừng bạn đến với phiên đấu giá!" wrapText="true" style="-fx-text-fill: #27ae60; -fx-font-style: italic; -fx-font-weight: bold;"/>
            </VBox>

            <!-- CỘT PHẢI: BIỂU ĐỒ LINECHART -->
            <VBox spacing="15" prefWidth="600" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" HBox.hgrow="ALWAYS">
                <Label text="📈 Biểu đồ lịch sử giá" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #2c3e50;"/>

                <LineChart fx:id="priceChart" VBox.vgrow="ALWAYS" createSymbols="true" animated="true" style="-fx-cursor: crosshair;">
                    <xAxis>
                        <NumberAxis label="Lượt đặt" autoRanging="true"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Giá (VND)" autoRanging="true"/>
                    </yAxis>
                </LineChart>
            </VBox>

        </HBox>
    </center>
</BorderPane>