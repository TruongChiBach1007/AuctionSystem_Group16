<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<BorderPane stylesheets="@css/styles.css" prefWidth="1200" prefHeight="750" style="-fx-background-color: #f0f4ff;"
            xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.controller.SellerDashboardController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: white; -fx-padding: 12 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <Label text="AUCTION.IO" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1e3a8a; -fx-letter-spacing: 0.1em;"/>

            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #f8fbff; -fx-padding: 8 20; -fx-background-radius: 20; -fx-border-color: #dbeafe;">
                <Label text="🏠 Seller Dashboard" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="15">
                <VBox alignment="CENTER_RIGHT">
                    <Label fx:id="lblUsername" text="Tên tài khoản: Admin" style="-fx-font-weight: bold; -fx-font-size: 13; -fx-text-fill: #1e293b;"/>
                </VBox>
                <Button text="⇒  Đăng xuất" onAction="#handleLogout"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #e74c3c;
                               -fx-border-radius: 20;
                               -fx-text-fill: #e74c3c;
                               -fx-cursor: hand;
                               -fx-padding: 8 16;
                               -fx-font-weight: bold;
                               -fx-font-size: 12;"/>
            </HBox>
        </HBox>
    </top>

    <center>
        <HBox spacing="25" style="-fx-padding: 25;">

            <VBox spacing="20" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 15 20; -fx-background-color: white;">
                    <VBox>
                        <Label text="SẢN PHẨM CỦA TÔI" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                        <Label text="Quản lý các phiên đấu giá bạn đã tạo" style="-fx-font-size: 12; -fx-text-fill: #64748b;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <VBox styleClass="card" VBox.vgrow="ALWAYS" style="-fx-padding: 5;">
                    <TableView fx:id="tableItems" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="200"/>
                            <TableColumn fx:id="colCategory" text="Danh mục" prefWidth="130"/>
                            <TableColumn fx:id="colStartPrice" text="Giá khởi điểm" prefWidth="150"/>
                            <TableColumn fx:id="colCurrentPrice" text="Giá hiện tại" prefWidth="150"/>
                            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="130"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <HBox spacing="15">
                    <Button text="✏️ Sửa sản phẩm" onAction="#handleEdit" styleClass="btn-primary" prefWidth="180"/>
                    <Button text="🗑️ Xóa sản phẩm" onAction="#handleDelete"
                            style="-fx-background-color: #fee2e2; -fx-text-fill: #ef4444;
                                   -fx-font-weight: bold; -fx-padding: 10 20;
                                   -fx-background-radius: 8; -fx-cursor: hand;" prefWidth="180"/>
                </HBox>
            </VBox>

            <!-- FORM BÊN PHẢI -->
            <VBox spacing="18" prefWidth="350" styleClass="card" style="-fx-padding: 25; -fx-background-color: white;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Circle radius="5" fill="#3b82f6" />
                    <Label fx:id="lblFormTitle" text="THÊM SẢN PHẨM"
                           style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
                </HBox>

                <Separator style="-fx-opacity: 0.5;"/>

                <VBox spacing="15">

                    <!-- Danh mục -->
                    <VBox spacing="5">
                        <Label text="Danh mục" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;"/>
                        <ComboBox fx:id="cmbCategory" maxWidth="Infinity"
                                  promptText="Chọn danh mục..." styleClass="combo-box"/>
                    </VBox>

                    <!-- Tên sản phẩm -->
                    <VBox spacing="5">
                        <Label text="Tên sản phẩm" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;"/>
                        <TextField fx:id="txtName" promptText="Nhập tên sản phẩm..." styleClass="text-field"/>
                    </VBox>

                    <!-- Mô tả -->
                    <VBox spacing="5">
                        <Label text="Mô tả" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;"/>
                        <TextArea fx:id="txtDescription" promptText="Mô tả chi tiết sản phẩm..."
                                  prefHeight="80" wrapText="true" styleClass="text-area"/>
                    </VBox>

                    <!-- Giá -->
                    <VBox spacing="5">
                        <Label text="Giá khởi điểm (VNĐ)" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;"/>
                        <TextField fx:id="txtStartPrice" promptText="VD: 1.000.000" styleClass="text-field"/>
                    </VBox>

                    <!-- ẢNH SẢN PHẨM — chọn từ máy -->
                    <VBox spacing="5">
                        <Label text="Ảnh sản phẩm" style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <!-- TextField chỉ đọc, hiện tên file -->
                            <TextField fx:id="txtImageUrl"
                                       promptText="Chưa chọn ảnh..."
                                       HBox.hgrow="ALWAYS"
                                       style="-fx-background-color: #f5f7fc;
                                              -fx-border-color: #dde3f0;
                                              -fx-border-radius: 8;
                                              -fx-background-radius: 8;
                                              -fx-padding: 8 12;
                                              -fx-font-size: 12;"/>
                            <!-- Nút chọn ảnh -->
                            <Button text="📁 Chọn"
                                    onAction="#handleChooseImage"
                                    style="-fx-background-color: #3b82f6;
                                           -fx-text-fill: white;
                                           -fx-font-weight: bold;
                                           -fx-padding: 8 12;
                                           -fx-background-radius: 8;
                                           -fx-cursor: hand;
                                           -fx-font-size: 12;"/>
                        </HBox>
                        <!-- Preview ảnh nhỏ -->
                        <ImageView fx:id="imgPreview"
                                   fitWidth="80" fitHeight="80"
                                   preserveRatio="true"
                                   visible="false" managed="false"
                                   style="-fx-background-radius: 8;"/>
                    </VBox>

                    <!-- Field phụ theo danh mục -->
                    <VBox fx:id="vboxExtra" spacing="5" visible="false" managed="false">
                        <Label fx:id="lblExtra" text="Thông tin thêm"
                               style="-fx-font-weight: bold; -fx-text-fill: #475569; -fx-font-size: 12;"/>
                        <TextField fx:id="txtExtra" styleClass="text-field"/>
                    </VBox>

                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="10">
                    <Button fx:id="btnSave" text="💾 LƯU SẢN PHẨM" onAction="#handleSave"
                            maxWidth="Infinity" styleClass="btn-success" style="-fx-padding: 12;"/>
                    <Button text="↩️ Hủy bỏ" onAction="#handleCancel"
                            maxWidth="Infinity" styleClass="btn-secondary" style="-fx-padding: 10;"/>
                </VBox>
            </VBox>

        </HBox>
    </center>
</BorderPane>