<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<HBox
        alignment="CENTER"
        stylesheets="@css/styles.css"
        xmlns="http://javafx.com/javafx/8"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.auction.controller.RegisterController"
        style="-fx-background-color: #c8d8f8;">

    <!-- NỬA TRÁI -->
    <VBox
            prefWidth="560"
            alignment="CENTER_LEFT"
            spacing="0"
            style="-fx-background-color: #dce8fd;
               -fx-padding: 44 44 44 44;">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 28 0;">
            <StackPane minWidth="44" minHeight="44" maxWidth="44" maxHeight="44"
                       style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                <Label text="🔨" style="-fx-font-size: 20;"/>
            </StackPane>
            <Label text="AUCTIONVN"
                   style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
        </HBox>

        <!-- Hero title -->
        <VBox spacing="0" style="-fx-padding: 0 0 12 0;">
            <Label text="Tạo tài khoản"
                   style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
            <Label text="mới ngay hôm nay"
                   style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
        </VBox>

        <!-- Sub text -->
        <Label
                text="Tham gia hàng nghìn phiên đấu giá uy tín — nghệ thuật, cổ vật, xa xỉ phẩm, và nhiều hơn nữa."
                wrapText="true"
                maxWidth="380"
                style="-fx-font-size: 14; -fx-text-fill: #4a6080; -fx-padding: 0 0 28 0;"/>

        <!-- 4 Features -->
        <GridPane hgap="14" vgap="14">

            <HBox alignment="TOP_LEFT" spacing="10"
                  GridPane.columnIndex="0" GridPane.rowIndex="0"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-border-color: rgba(59,130,246,0.2); -fx-border-radius: 10;
                         -fx-padding: 12;">
                <StackPane minWidth="40" minHeight="40" maxWidth="40" maxHeight="40"
                           style="-fx-background-color: rgba(59,130,246,0.15); -fx-background-radius: 8;">
                    <Label text="📈" style="-fx-font-size: 16;"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Đấu giá trực tiếp"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
                    <Label text="Tham gia đấu thầu theo thời gian thực"
                           style="-fx-font-size: 11; -fx-text-fill: #4a6080;"
                           wrapText="true" maxWidth="150"/>
                </VBox>
            </HBox>

            <HBox alignment="TOP_LEFT" spacing="10"
                  GridPane.columnIndex="1" GridPane.rowIndex="0"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-border-color: rgba(59,130,246,0.2); -fx-border-radius: 10;
                         -fx-padding: 12;">
                <StackPane minWidth="40" minHeight="40" maxWidth="40" maxHeight="40"
                           style="-fx-background-color: rgba(59,130,246,0.15); -fx-background-radius: 8;">
                    <Label text="🏛️" style="-fx-font-size: 16;"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Hàng nghìn tài sản"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e3154;"
                           wrapText="true" maxWidth="150"/>
                    <Label text="Nghệ thuật, cổ vật, xa xỉ phẩm"
                           style="-fx-font-size: 11; -fx-text-fill: #4a6080;"
                           wrapText="true" maxWidth="150"/>
                </VBox>
            </HBox>

            <HBox alignment="TOP_LEFT" spacing="10"
                  GridPane.columnIndex="0" GridPane.rowIndex="1"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-border-color: rgba(59,130,246,0.2); -fx-border-radius: 10;
                         -fx-padding: 12;">
                <StackPane minWidth="40" minHeight="40" maxWidth="40" maxHeight="40"
                           style="-fx-background-color: rgba(59,130,246,0.15); -fx-background-radius: 8;">
                    <Label text="🛡️" style="-fx-font-size: 16;"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="An toàn &amp; Uy tín"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
                    <Label text="Bảo mật giao dịch tuyệt đối"
                           style="-fx-font-size: 11; -fx-text-fill: #4a6080;"
                           wrapText="true" maxWidth="150"/>
                </VBox>
            </HBox>

            <HBox alignment="TOP_LEFT" spacing="10"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-border-color: rgba(59,130,246,0.2); -fx-border-radius: 10;
                         -fx-padding: 12;">
                <StackPane minWidth="40" minHeight="40" maxWidth="40" maxHeight="40"
                           style="-fx-background-color: rgba(59,130,246,0.15); -fx-background-radius: 8;">
                    <Label text="📊" style="-fx-font-size: 16;"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Giá trị tốt nhất"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
                    <Label text="Cơ hội đầu tư sinh lời cao"
                           style="-fx-font-size: 11; -fx-text-fill: #4a6080;"
                           wrapText="true" maxWidth="150"/>
                </VBox>
            </HBox>

        </GridPane>
    </VBox>

    <!-- NỬA PHẢI — Form đăng ký -->
    <VBox
            prefWidth="440"
            alignment="CENTER_LEFT"
            spacing="0"
            style="-fx-background-color: #e8f0fe;
               -fx-border-color: transparent transparent transparent rgba(59,130,246,0.2);
               -fx-border-width: 0 0 0 1;
               -fx-padding: 36 40 36 40;">

        <Label text="Đăng ký"
               style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>

        <Region minHeight="4"/>

        <Label text="Điền thông tin để tạo tài khoản mới"
               style="-fx-font-size: 13; -fx-text-fill: #4a6080;"/>

        <Region minHeight="20"/>

        <!-- Họ và tên -->
        <VBox spacing="6">
            <Label text="Họ và tên"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #4a6080;"/>
            <TextField fx:id="txtFullName" promptText="Nhập họ và tên..."
                       style="-fx-background-color: white;
                              -fx-border-color: rgba(59,130,246,0.35);
                              -fx-border-radius: 10; -fx-background-radius: 10;
                              -fx-padding: 11 16; -fx-font-size: 13;
                              -fx-text-fill: #1e3154; -fx-prompt-text-fill: #a0b4cc;"/>
        </VBox>

        <Region minHeight="12"/>

        <!-- Tên tài khoản -->
        <VBox spacing="6">
            <Label text="Tên tài khoản"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #4a6080;"/>
            <TextField fx:id="txtUsername" promptText="Nhập tên tài khoản..."
                       style="-fx-background-color: white;
                              -fx-border-color: rgba(59,130,246,0.35);
                              -fx-border-radius: 10; -fx-background-radius: 10;
                              -fx-padding: 11 16; -fx-font-size: 13;
                              -fx-text-fill: #1e3154; -fx-prompt-text-fill: #a0b4cc;"/>
        </VBox>

        <Region minHeight="12"/>

        <!-- Email -->
        <VBox spacing="6">
            <Label text="Email"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #4a6080;"/>
            <TextField fx:id="txtEmail" promptText="Nhập email..."
                       style="-fx-background-color: white;
                              -fx-border-color: rgba(59,130,246,0.35);
                              -fx-border-radius: 10; -fx-background-radius: 10;
                              -fx-padding: 11 16; -fx-font-size: 13;
                              -fx-text-fill: #1e3154; -fx-prompt-text-fill: #a0b4cc;"/>
        </VBox>

        <Region minHeight="12"/>

        <!-- Mật khẩu -->
        <VBox spacing="6">
            <Label text="Mật khẩu"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #4a6080;"/>
            <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu..."
                           style="-fx-background-color: white;
                                  -fx-border-color: rgba(59,130,246,0.35);
                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                  -fx-padding: 11 16; -fx-font-size: 13;
                                  -fx-text-fill: #1e3154; -fx-prompt-text-fill: #a0b4cc;"/>
        </VBox>

        <Region minHeight="6"/>

        <!-- Error label -->
        <Label fx:id="messageLabel"
               wrapText="true" maxWidth="360"
               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>

        <Region minHeight="8"/>

        <!-- Nút đăng ký -->
        <Button text="ĐĂNG KÝ" onAction="#handleRegister" prefWidth="360"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 14; -fx-padding: 13;
                       -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.35), 16, 0, 0, 4);"/>

        <Region minHeight="14"/>

        <!-- Dòng quay lại -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="Đã có tài khoản?"
                   style="-fx-font-size: 13; -fx-text-fill: #4a6080;"/>
            <Button text="Đăng nhập ngay" onAction="#handleBackToLogin"
                    style="-fx-background-color: transparent; -fx-font-size: 13;
               -fx-font-weight: bold; -fx-text-fill: #3b82f6;
               -fx-border-color: transparent; -fx-cursor: hand;
               -fx-padding: 0;"/>
        </HBox>

    </VBox>

</HBox>