<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Nền xám nhạt đằng sau -->
<StackPane style="-fx-background-color: #e9ecef;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.LoginController">

    <!-- Khung Card chính, chia làm 2 nửa -->
    <HBox maxWidth="800" maxHeight="500" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">

        <!-- NỬA BÊN TRÁI: Chứa ảnh minh họa -->
        <VBox alignment="CENTER" prefWidth="400" style="-fx-background-color: #f4f7f6; -fx-background-radius: 15 0 0 15;">
            <!-- Đường dẫn trỏ tới thư mục images mà Minh vừa tạo -->
            <ImageView fitWidth="350" preserveRatio="true">
                <image>
                    <!-- Chú ý: Đảm bảo ảnh của Minh tên là auction_bg.png -->
                    <Image url="@images/auction_bg.png"/>
                </image>
            </ImageView>
        </VBox>

        <!-- NỬA BÊN PHẢI: Form Đăng nhập -->
        <VBox alignment="CENTER_LEFT" prefWidth="400" spacing="20">
            <padding>
                <Insets top="50" right="40" bottom="50" left="40"/>
            </padding>

            <!-- Tiêu đề chính và phụ -->
            <VBox spacing="5">
                <Label text="WEB ĐẤU GIÁ TRỰC TUYẾN" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Đăng nhập để tiếp tục" style="-fx-font-size: 14; -fx-text-fill: #7f8c8d;"/>
            </VBox>

            <!-- Ô nhập Tên (Viền xanh lá theo thiết kế) -->
            <VBox spacing="8">
                <Label text="Vui lòng nhập tên tài khoản" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;"/>
                <TextField fx:id="nameField" promptText="Username ..." style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #376fd1; -fx-border-radius: 5; -fx-border-width: 1;"/>
            </VBox>

            <!-- Ô nhập Mật khẩu (Viền xanh lá) -->
            <VBox spacing="8">
                <Label text="Vui lòng nhập mật khẩu" style="-fx-text-fill: #95a5a6; -fx-font-size: 12;"/>
                <PasswordField fx:id="passwordField" promptText="Password ..." style="-fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #1e5c9a; -fx-border-radius: 5; -fx-border-width: 1;"/>
            </VBox>

            <!-- Nơi hiện thông báo lỗi -->
            <Label fx:id="messageLabel" textFill="#e74c3c" wrapText="true" style="-fx-font-weight: bold;"/>

            <!-- Nút bấm to, xanh lá chuẩn mockup -->
            <Button text="ĐĂNG NHẬP" onAction="#handleConnect" prefWidth="320" style="-fx-background-color: #377ad1; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-padding: 12; -fx-background-radius: 5; -fx-cursor: hand;"/>
        </VBox>

    </HBox>
</StackPane>