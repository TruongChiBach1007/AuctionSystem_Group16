<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<HBox
        alignment="CENTER"
        stylesheets="@css/styles.css"
        xmlns="http://javafx.com/javafx/8"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.auction.controller.LoginController"
        style="-fx-background-color: #c8d8f8;">

    <!-- NỬA TRÁI -->
    <VBox
            prefWidth="560"
            alignment="CENTER_LEFT"
            spacing="0"
            style="-fx-background-color: #dce8fd;
               -fx-padding: 44 44 44 44;">

        <!-- Logo -->
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 28 0;">
            <!-- Icon logo hình búa đấu giá -->
            <StackPane minWidth="44" minHeight="44" maxWidth="44" maxHeight="44"
                       style="-fx-background-color: #3b82f6; -fx-background-radius: 10;">
                <Label text="🔨" style="-fx-font-size: 20;"/>
            </StackPane>
            <Label text="AUCTIONVN"
                   style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
        </HBox>

        <!-- Hero title -->
        <VBox spacing="0" style="-fx-padding: 0 0 12 0;">
            <Label text="Nền tảng Đấu Giá"
                   style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
            <Label text="Trực Tuyến"
                   style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
        </VBox>

        <!-- Sub text -->
        <Label
                text="Tham gia hàng nghìn phiên đấu giá uy tín — nghệ thuật, cổ vật, xa xỉ phẩm, và nhiều hơn nữa."
                wrapText="true"
                maxWidth="380"
                style="-fx-font-size: 14; -fx-text-fill: #4a6080; -fx-padding: 0 0 24 0;"/>

        <!-- 4 Features -->
        <GridPane hgap="14" vgap="14">

            <!-- Feature 1 -->
            <HBox alignment="TOP_LEFT" spacing="10"
                  GridPane.columnIndex="0" GridPane.rowIndex="0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(59,130,246,0.2);
                         -fx-border-radius: 10;
                         -fx-padding: 12;">
                <StackPane minWidth="40" minHeight="40" maxWidth="40" maxHeight="40"
                           style="-fx-background-color: rgba(59,130,246,0.15); -fx-background-radius: 8;">
                    <Label text="📈" style="-fx-font-size: 16;"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Đấu giá trực tiếp"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
                    <Label text="Tham gia đấu thầu theo thời gian thực"
                           style="-fx-font-size: 11; -fx-text-fill: #4a6080;"
                           wrapText="true" maxWidth="150"/>
                </VBox>
            </HBox>

            <!-- Feature 2 -->
            <HBox alignment="TOP_LEFT" spacing="10"
                  GridPane.columnIndex="1" GridPane.rowIndex="0"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(59,130,246,0.2);
                         -fx-border-radius: 10;
                         -fx-padding: 12;">
                <StackPane minWidth="40" minHeight="40" maxWidth="40" maxHeight="40"
                           style="-fx-background-color: rgba(59,130,246,0.15); -fx-background-radius: 8;">
                    <Label text="🏛️" style="-fx-font-size: 16;"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Hàng nghìn tài sản"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e3154;"
                           wrapText="true" maxWidth="150"/>
                    <Label text="Nghệ thuật, cổ vật, xa xỉ phẩm"
                           style="-fx-font-size: 11; -fx-text-fill: #4a6080;"
                           wrapText="true" maxWidth="150"/>
                </VBox>
            </HBox>

            <!-- Feature 3 -->
            <HBox alignment="TOP_LEFT" spacing="10"
                  GridPane.columnIndex="0" GridPane.rowIndex="1"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(59,130,246,0.2);
                         -fx-border-radius: 10;
                         -fx-padding: 12;">
                <StackPane minWidth="40" minHeight="40" maxWidth="40" maxHeight="40"
                           style="-fx-background-color: rgba(59,130,246,0.15); -fx-background-radius: 8;">
                    <Label text="🛡️" style="-fx-font-size: 16;"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="An toàn &amp; Uy tín"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
                    <Label text="Bảo mật giao dịch tuyệt đối"
                           style="-fx-font-size: 11; -fx-text-fill: #4a6080;"
                           wrapText="true" maxWidth="150"/>
                </VBox>
            </HBox>

            <!-- Feature 4 -->
            <HBox alignment="TOP_LEFT" spacing="10"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"
                  style="-fx-background-color: white;
                         -fx-background-radius: 10;
                         -fx-border-color: rgba(59,130,246,0.2);
                         -fx-border-radius: 10;
                         -fx-padding: 12;">
                <StackPane minWidth="40" minHeight="40" maxWidth="40" maxHeight="40"
                           style="-fx-background-color: rgba(59,130,246,0.15); -fx-background-radius: 8;">
                    <Label text="📊" style="-fx-font-size: 16;"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Giá trị tốt nhất"
                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>
                    <Label text="Cơ hội đầu tư sinh lời cao"
                           style="-fx-font-size: 11; -fx-text-fill: #4a6080;"
                           wrapText="true" maxWidth="150"/>
                </VBox>
            </HBox>

        </GridPane>
    </VBox>

    <!-- NỬA PHẢI -->
    <VBox
            prefWidth="440"
            alignment="CENTER_LEFT"
            spacing="0"
            style="-fx-background-color: #e8f0fe;
               -fx-border-color: transparent transparent transparent rgba(59,130,246,0.2);
               -fx-border-width: 0 0 0 1;
               -fx-padding: 44 40 44 40;">

        <!-- Security badge -->
        <HBox alignment="CENTER_LEFT" spacing="6"
              style="-fx-background-color: rgba(34,197,94,0.12);
                     -fx-background-radius: 20;
                     -fx-border-color: rgba(34,197,94,0.35);
                     -fx-border-radius: 20;
                     -fx-padding: 5 12 5 12;"
              maxWidth="175">
            <Circle radius="4" style="-fx-fill: #16a34a;"/>
            <Label text="Cổng đăng nhập bảo mật"
                   style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
        </HBox>

        <Region minHeight="20"/>

        <Label text="Đăng nhập"
               style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #1e3154;"/>

        <Region minHeight="6"/>

        <Label text="Chào mừng trở lại — vui lòng xác thực tài khoản"
               style="-fx-font-size: 13; -fx-text-fill: #4a6080;"/>

        <Region minHeight="26"/>

        <!-- Username -->
        <VBox spacing="8">
            <Label text="Tên tài khoản"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #4a6080;"/>
            <TextField
                    fx:id="nameField"
                    promptText="Nhập tên tài khoản..."
                    style="-fx-background-color: #ffffff;
                       -fx-border-color: rgba(59,130,246,0.35);
                       -fx-border-radius: 10; -fx-background-radius: 10;
                       -fx-padding: 13 16 13 16;
                       -fx-font-size: 14; -fx-text-fill: #1e3154;
                       -fx-prompt-text-fill: #a0b4cc;"/>
        </VBox>

        <Region minHeight="16"/>

        <!-- Password -->
        <VBox spacing="8">
            <Label text="Mật khẩu"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #4a6080;"/>
            <PasswordField
                    fx:id="passwordField"
                    onAction="#handleConnect"
                    promptText="Nhập mật khẩu..."
                    style="-fx-background-color: #ffffff;
                       -fx-border-color: rgba(59,130,246,0.35);
                       -fx-border-radius: 10; -fx-background-radius: 10;
                       -fx-padding: 13 16 13 16;
                       -fx-font-size: 14; -fx-text-fill: #1e3154;
                       -fx-prompt-text-fill: #a0b4cc;"/>
        </VBox>

        <Region minHeight="6"/>

        <!-- Error label -->
        <Label fx:id="messageLabel"
               wrapText="true"
               maxWidth="360"
               style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>

        <Region minHeight="8"/>

        <!-- Login button -->
        <Button
                text="ĐĂNG NHẬP"
                onAction="#handleConnect"
                prefWidth="360"
                style="-fx-background-color: #3b82f6;
                   -fx-text-fill: white;
                   -fx-font-weight: bold; -fx-font-size: 14;
                   -fx-padding: 14;
                   -fx-background-radius: 10;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(three-pass-box, rgba(59,130,246,0.35), 16, 0, 0, 4);"/>

        <Region minHeight="16"/>

        <!-- Register -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="Chưa có tài khoản?"
                   style="-fx-font-size: 13; -fx-text-fill: #4a6080;"/>
            <Hyperlink text="Đăng ký ngay"
                       style="-fx-font-size: 13; -fx-font-weight: bold;
                              -fx-text-fill: #3b82f6; -fx-border-color: transparent;"/>
        </HBox>

    </VBox>

</HBox>